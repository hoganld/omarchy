#!/bin/bash

cache_dir=~/.local/state/ddcci
queue_file="$cache_dir/queue"

lockup() {
  exec {lockfd}>"$cache_dir/lock" || return 1
  flock -x $lockfd
}

unlock() {
  test "$lockfd" || return 1
  exec {lockfd}>&- && unset lockfd
}

find_cache_file() {
  lockup
  grep -il "$1" "$cache_dir"/display* 2> /dev/null
  unlock
}

input="${1:-+5%}"

if [[ "$input" == "+"*"-" ]]; then
  echo "Error: decide if you want to increase or decrease the display brightness and try again."
  exit 1
fi

serial="$(hyprctl monitors -j | jq -r '.[] | select(.focused==true).serial')"

cache_file="$(find_cache_file "$serial")"
# If no cache file is found, update the cache and try again
if [[ -z "$cache_file" ]]; then
  $OMARCHY_PATH/bin/omarchy-ddcci-cache
  lockup
  cache_file="$(find_cache_file "$serial")"
  unlock
fi

# If we still find no cache file, quit
if [[ -z "$cache_file" ]]; then
  echo "Error: Cannot control this display with ddcutil."
  exit 1
fi

lockup
# Read the cached brightness for the current monitor.
old_target="$(awk -F ":" '/Target Brightness/ { print $2 }' "$cache_file")"

# Set the direction and degree of change.
step=$(echo "$input" | awk '{ gsub("\\+", ""); gsub("%", ""); gsub("-", ""); print $0 }')
if [[ "$input" == "+"* ]]; then
  new_target=$(($old_target + $step))
elif [[ "$input" == *"-" ]]; then
  new_target=$(($old_target - $step))
else
  new_target=$step
fi
new_target=$(($new_target < 0 ? 0 : $new_target))
new_target=$(($new_target > 100 ? 100 : $new_target))

# Record the target brightness and add the display to the DDC/CI queue
sed -i "s/^Target Brightness.*$/Target Brightness: $new_target/" "$cache_file"
if [[ -z $(grep "$serial" "$queue_file" 2>/dev/null) ]]; then
  echo "$serial" >> "$queue_file"
fi
unlock

# Start the DDC/CI sync task
systemctl --user start omarchy-ddcci-sync.timer

# Use SwayOSD to display the new brightness setting.
omarchy-swayosd-brightness "$new_target"
