#!/bin/bash

working_dir=/tmp/ddcci
cache_dir=~/.local/state/ddcci
queue_file="$cache_dir/queue"
pending_file="$cache_dir/pending"

lockup() {
  exec {lockfd}>"$cache_dir/lock" || return 1
  flock -x $lockfd
}

unlock() {
  test "$lockfd" || return 1
  exec {lockfd}>&- && unset lockfd
}

# short circuit if DDC/CI operations are in progress
if [[ -f "$pending_file" || $(grep -v '^$' "$queue_file" | wc -l) != 0 ]]; then
  echo "Error: DDC/CI operations in progress"
  exit 1
fi

# setup
mkdir -p "$cache_dir"
rm -rf "$working_dir" > /dev/null 2>&1
mkdir -p "$working_dir" > /dev/null 2>&1
cd "$working_dir" > /dev/null 2>&1

# detect displays
ddcutil detect | csplit -sz --suppress-matched - '/^$/' {*} -f display

# ddcutil will report laptop displays even though they are unsupported
for laptop in $(grep -il "This is a laptop display" "$working_dir"/*); do
  rm "$laptop"
done

# Add current brightness and timestamp to each cache file
for fn in $(ls -1 display* 2> /dev/null); do
  bus="$(cat "$fn" | awk -F ":" '/I2C bus/ { gsub("/dev/i2c-", ""); print $2 }')"
  vcpdata="$(ddcutil --bus $bus getvcp 10)"
  brightness="$(echo $vcpdata | awk '{ gsub(",", ""); print $9 }')"
  maximum="$(echo $vcpdata | awk '{ gsub(",", ""); print $13 }')"
  echo "Maximum Brightness: $maximum" >> "$fn"
  echo "Current Brightness: $brightness" >> "$fn"
  echo "Target Brightness: $brightness" >> "$fn"
done

lockup
# clear the old cache files
rm "$cache_dir/"display* > /dev/null 2>&1
mkdir -p "$cache_dir"
touch "$queue_file"

# install the new cache files
for fn in $(ls -1 display* 2> /dev/null); do
  mv "$fn" "$cache_dir"
done
unlock

# cleanup
cd - > /dev/null 2>&1
rmdir "$working_dir"
